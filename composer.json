{
    "name": "garlicsignage/garlic-analytics",
    "description": "Self-hosted analytics service for digital signage players",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "slim/slim": "^4",
        "slim/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
