declare(strict_types=1);

use App\Framework\Database\Migration\MigrateCommand;
use App\Modules\Auth\Commands\CreateApiKeyCommand;
use App\Modules\Auth\Commands\ListApiKeysCommand;
use App\Modules\Auth\Commands\RevokeApiKeyCommand;
use Psr\Container\ContainerInterface;
use Slim\App;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;

if (PHP_SAPI !== 'cli')
    exit(1);

/** @var App<ContainerInterface> $app */
$app       = require dirname(__DIR__) . '/config/bootstrap.php';
$container = $app->getContainer();

$commands = [
    MigrateCommand::class,
    CreateApiKeyCommand::class,
    ListApiKeysCommand::class,
    RevokeApiKeyCommand::class,
];

$console = new Application('garlic-analytics');
foreach ($commands as $class)
{
    /** @var Command $command */
    $command = $container->get($class);
    $console->addCommand($command);
}

exit($console->run());
